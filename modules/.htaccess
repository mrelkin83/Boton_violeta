# Botón Violeta — bloqueo de acceso HTTP directo
# CLAUDE.md §5.1.3 · Ac. 003 art. 45 (reserva del expediente)

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

# Defensa en profundidad: desactivar el motor PHP en este directorio
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
