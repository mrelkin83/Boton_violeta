# ==============================================================================
# BOTÓN VIOLETA - CONFIGURACIÓN APACHE
# ==============================================================================
# Sistema de Gestión de Denuncias de Violencia de Género
# Configuración optimizada para hosting compartido
# ==============================================================================

# ------------------------------------------------------------------------------
# SEGURIDAD GENERAL
# ------------------------------------------------------------------------------

# Desactivar listado de directorios
Options -Indexes

# Seguir enlaces simbólicos (necesario para algunas configuraciones)
Options +FollowSymLinks

# Desactivar firma del servidor
ServerSignature Off

# Proteger archivos sensibles  (CLAUDE.md §5.1.1)
<FilesMatch "^(config\.php|config\.example\.php|bv_config\.php|init\.php|\.env|composer\.(json|lock)|package\.json|\.git.*|\.gitignore|\.htaccess)$">
    Require all denied
</FilesMatch>

# Proteger directorios sensibles  (CLAUDE.md §5.1.3)
RedirectMatch 403 ^/\.git
RedirectMatch 403 ^/includes/
RedirectMatch 403 ^/logs/
RedirectMatch 403 ^/sessions/
RedirectMatch 403 ^/cache/
RedirectMatch 403 ^/modules/
RedirectMatch 403 ^/uploads/
RedirectMatch 403 ^/backups/
RedirectMatch 403 ^/bd/
RedirectMatch 403 ^/pruebas/
RedirectMatch 403 ^/views/

# Bloquear acceso a archivos de backup y documentación interna
# (.md añadido el 2026-09-02: CLAUDE.md, README_NATIVO.md y los informes
# técnicos describen hallazgos de seguridad y credenciales documentadas;
# se descargaban públicamente desde el servidor)
<FilesMatch "\.(bak|backup|old|sql|log|ini|conf|md)$">
    Require all denied
</FilesMatch>

# ------------------------------------------------------------------------------
# MOTOR DE REESCRITURA (URL AMIGABLES)
# ------------------------------------------------------------------------------

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Forzar HTTPS (comentar si no tienes SSL)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Remover www (opcional - descomenta si quieres sin www)
    # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    # RewriteRule ^(.*)$ http://%1/$1 [R=301,L]

    # Agregar www (opcional - descomenta si quieres con www)
    # RewriteCond %{HTTP_HOST} !^www\. [NC]
    # RewriteRule ^(.*)$ http://www.%{HTTP_HOST}/$1 [R=301,L]

    # Redirigir todas las peticiones al index_nativo.php
    # Excepto archivos y directorios que existen
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index_nativo.php [QSA,L]

    # Prevenir acceso directo a index_nativo.php (opcional)
    # RewriteCond %{THE_REQUEST} /index_nativo\.php [NC]
    # RewriteRule ^(.*)index_nativo\.php$ /$1 [R=301,L]
</IfModule>

# ------------------------------------------------------------------------------
# PÁGINAS DE ERROR PERSONALIZADAS
# ------------------------------------------------------------------------------

ErrorDocument 404 /views/errors/404.php
ErrorDocument 500 /views/errors/500.php
ErrorDocument 403 /views/errors/404.php

# ------------------------------------------------------------------------------
# SEGURIDAD: HEADERS HTTP
# ------------------------------------------------------------------------------

<IfModule mod_headers.c>
    # Prevenir clickjacking · DENY (CLAUDE.md §11); mismo valor que envía
    # set_security_headers() en PHP para no emitir la cabecera duplicada
    # con valores en conflicto
    Header always set X-Frame-Options "DENY"

    # Prevenir XSS
    Header always set X-XSS-Protection "1; mode=block"

    # Prevenir MIME type sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Política de referrer
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Content Security Policy (ajustar según necesidades)
    # Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com; img-src 'self' data: https:; font-src 'self' data:;"

    # Remover headers que exponen información del servidor
    Header unset X-Powered-By
    Header unset Server

    # HSTS - Forzar HTTPS (descomentar solo si tienes SSL válido)
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Permissions Policy (antes Feature-Policy)
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ------------------------------------------------------------------------------
# COMPRESIÓN GZIP
# ------------------------------------------------------------------------------

<IfModule mod_deflate.c>
    # Comprimir HTML, CSS, JavaScript, XML, JSON
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml

    # No comprimir imágenes ya comprimidas
    SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|ico)$ no-gzip dont-vary
</IfModule>

# ------------------------------------------------------------------------------
# CACHÉ DEL NAVEGADOR
# ------------------------------------------------------------------------------

<IfModule mod_expires.c>
    ExpiresActive On

    # Imágenes
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"

    # CSS y JavaScript
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/x-javascript "access plus 1 month"

    # Fuentes
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"

    # HTML y JSON (sin caché para contenido dinámico)
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/json "access plus 0 seconds"

    # Default
    ExpiresDefault "access plus 1 month"
</IfModule>

# Control de caché alternativo si mod_expires no está disponible
<IfModule mod_headers.c>
    <FilesMatch "\.(jpg|jpeg|png|gif|svg|webp|ico)$">
        Header set Cache-Control "max-age=31536000, public"
    </FilesMatch>

    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "max-age=2592000, public"
    </FilesMatch>

    <FilesMatch "\.(woff|woff2|ttf|otf|eot)$">
        Header set Cache-Control "max-age=31536000, public"
    </FilesMatch>
</IfModule>

# ------------------------------------------------------------------------------
# PREVENCIÓN DE HOTLINKING (ROBO DE IMÁGENES)
# ------------------------------------------------------------------------------

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Permitir acceso directo, Google, y tu dominio
    RewriteCond %{HTTP_REFERER} !^$
    RewriteCond %{HTTP_REFERER} !^https?://(www\.)?tu-dominio\.com [NC]
    RewriteCond %{HTTP_REFERER} !^https?://(www\.)?google\. [NC]
    # Bloquear imágenes
    RewriteCond %{REQUEST_URI} \.(jpe?g|png|gif|svg|webp)$ [NC]
    # Redirigir o denegar
    # RewriteRule .* - [F,L]
</IfModule>

# ------------------------------------------------------------------------------
# LÍMITES DE SUBIDA DE ARCHIVOS
# ------------------------------------------------------------------------------

# Nota: Estos límites pueden ser sobreescritos por configuraciones del servidor
# Consulta con tu proveedor de hosting para límites definitivos

<IfModule mod_php.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 10M
    php_value max_execution_time 300
    php_value max_input_time 300
    php_value memory_limit 256M
</IfModule>

# Para PHP 7+ con CGI/FastCGI
<IfModule mod_fcgid.c>
    FcgidMaxRequestLen 10485760
</IfModule>

# ------------------------------------------------------------------------------
# UTF-8 ENCODING
# ------------------------------------------------------------------------------

AddDefaultCharset UTF-8

<IfModule mod_mime.c>
    AddCharset UTF-8 .html .css .js .xml .json .rss .atom
</IfModule>

# ------------------------------------------------------------------------------
# TIPOS MIME
# ------------------------------------------------------------------------------

<IfModule mod_mime.c>
    # JavaScript
    AddType application/javascript js
    AddType application/json json

    # Fuentes
    AddType font/woff woff
    AddType font/woff2 woff2
    AddType font/ttf ttf
    AddType font/otf otf

    # SVG
    AddType image/svg+xml svg svgz

    # WebP
    AddType image/webp webp
</IfModule>

# ------------------------------------------------------------------------------
# PROTECCIÓN CONTRA INYECCIÓN SQL Y XSS
# ------------------------------------------------------------------------------

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Bloquear peticiones sospechosas en URL
    RewriteCond %{QUERY_STRING} (\<|%3C).*script.*(\>|%3E) [NC,OR]
    RewriteCond %{QUERY_STRING} GLOBALS(=|\[|\%[0-9A-Z]{0,2}) [OR]
    RewriteCond %{QUERY_STRING} _REQUEST(=|\[|\%[0-9A-Z]{0,2}) [OR]
    RewriteCond %{QUERY_STRING} (\.|%2E)(\.|%2E)(%2F|/) [OR]
    RewriteCond %{QUERY_STRING} (union|select|insert|drop|update|delete|cast|create|char|convert|alter|declare|exec|script|cookie|set|md5|benchmark) [NC]
    RewriteRule ^(.*)$ - [F,L]
</IfModule>

# ------------------------------------------------------------------------------
# PROTECCIÓN ADICIONAL
# ------------------------------------------------------------------------------

# Bloquear user agents sospechosos
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP_USER_AGENT} ^$ [OR]
    RewriteCond %{HTTP_USER_AGENT} (libwww|wget|python|nikto|scan|java|winhttp|clshttp|loader) [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} (;|<|>|'|"|\)|\(|%0A|%0D|%27|%3C|%3E|%00) [NC]
    # RewriteRule ^(.*)$ - [F,L]
</IfModule>

# Bloquear métodos HTTP no utilizados
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_METHOD} ^(TRACE|DELETE|TRACK|PUT|OPTIONS) [NC]
    RewriteRule ^(.*)$ - [F,L]
</IfModule>

# ------------------------------------------------------------------------------
# FIN DE CONFIGURACIÓN
# ------------------------------------------------------------------------------
# Si encuentras problemas, prueba comentando secciones específicas
# Algunos hostings compartidos tienen restricciones en ciertas directivas
# ==============================================================================
